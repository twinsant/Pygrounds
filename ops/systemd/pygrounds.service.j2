[Unit]
Description=Pygrounds Next.js application
After=network.target

[Service]
Type=simple
WorkingDirectory={{ app_path }}
Environment=PATH=/root/.bun/bin:/usr/local/bin:/usr/bin:/bin
Environment=NODE_ENV={{ node_env }}
ExecStart=/usr/bin/env bun {{ repo_path }}/node_modules/next/dist/bin/next start --hostname {{ listen_host }} --port {{ app_port }}
Restart=always
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target