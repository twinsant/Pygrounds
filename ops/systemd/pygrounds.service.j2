[Unit]
Description=Pygrounds Next.js application
After=network.target

[Service]
Type=simple
WorkingDirectory={{ app_path }}
Environment=PATH=/root/projects/twinsant.com/node-v22.17.1-linux-x64-glibc-217/bin:/root/.bun/bin:/usr/local/bin:/usr/bin:/bin
Environment=NODE_ENV={{ node_env }}
ExecStart=/root/projects/twinsant.com/node-v22.17.1-linux-x64-glibc-217/bin/node {{ repo_path }}/node_modules/next/dist/bin/next start --hostname {{ listen_host }} --port {{ app_port }}
Restart=always
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target